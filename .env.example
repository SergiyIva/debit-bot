# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
# Multimodal model that supports text + image + audio (e.g. google/gemini-2.5-flash)
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview

# Telegram
TG_BOT_TOKEN=123456:ABC...
# Optional whitelist (comma-separated Telegram user IDs); leave empty to allow everyone
TG_ALLOWED_USER_IDS=

# Google Sheets
SPREADSHEET_ID=1AbCdEfG...
# Either inline service-account JSON or absolute path to the JSON key file
CREDENTIALS_GOOGLE={"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}
SHEET_NAME=Sheet1

# Misc
TZ=Europe/Moscow

# Optional outbound HTTPS proxy for Telegram traffic.
# Either a plain URL (http://user:pass@host:port) or a JSON array of URLs (first one is used).
PROXY_URL=
